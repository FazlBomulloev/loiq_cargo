# --- Приложение
APP_ENV=dev
APP_DEBUG=true
APP_TZ=Asia/Dushanbe
LOG_LEVEL=INFO

# --- Безопасность
# Сгенерируй: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-secrets-token
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=1440

# --- PostgreSQL (используется backend и compose'ом)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=loik
POSTGRES_USER=loik
POSTGRES_PASSWORD=loik_dev_password

# Собранный DSN — можно задать явно, иначе backend соберёт сам
# DATABASE_URL=postgresql+asyncpg://loik:loik_dev_password@postgres:5432/loik

# --- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- CORS (список через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Первичные учётки (используются seed'ом при первом запуске)
OWNER_EMAIL=owner@loik.local
OWNER_PASSWORD=owner_change_me

# --- Telegram-бот (пока опционально, для этапа 3+)
TG_BOT_TOKEN=
TG_BOT_USERNAME=loiq_cargobot
